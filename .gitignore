# 本地配置
.claude/settings.local.json

# deliverables/ 过程产物（按 REQ-ID 隔离）
deliverables/REQ*/
deliverables/sa/
deliverables/te/
deliverables/de/
deliverables/output/
deliverables/baselines/
deliverables/proposal.md
deliverables/plan-action.md
deliverables/SR*-record.md
deliverables/process.log

# 保留全局指针和模板
!deliverables/.state.md
!deliverables/handoffs/
deliverables/handoffs/*
!deliverables/handoffs/.handoff-template.md

# spec/ 用户归档产物（框架仓库不含用户数据）
spec/*.md
spec/baselines/

# output 产物
output/final/

# 系统文件
.DS_Store
node_modules/
*.log

# 编辑器
.vscode/
!.vscode/settings.json
.idea/
