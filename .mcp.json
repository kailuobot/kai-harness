{
  "mcpServers": {
    "zai-mcp-server": {
      "command": "npx",
      "args": ["zai-mcp-server"],
      "env": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}"
      }
    },
    "web-search": {
      "command": "npx",
      "args": ["web-search-mcp-server"]
    },
    "web-reader": {
      "command": "npx",
      "args": ["web-reader-mcp-server"]
    }
  }
}
